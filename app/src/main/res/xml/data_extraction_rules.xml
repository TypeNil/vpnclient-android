<?xml version="1.0" encoding="utf-8"?>
<!-- Proxy credentials and subscription URLs must never leave the device:
     exclude everything from both cloud backup and device-to-device
     transfer. `domain="root"` covers files, databases and shared_prefs;
     allowBackup="false" already disables the cloud path — this makes the
     D2D exclusion explicit (D2D can ignore allowBackup on Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
